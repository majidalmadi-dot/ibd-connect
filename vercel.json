{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/eoe",
      "destination": "/EoE/",
      "permanent": true
    },
    {
      "source": "/eoe/",
      "destination": "/EoE/",
      "permanent": true
    },
    {
      "source": "/Maeen",
      "destination": "https://maeen.saudigastro.com/website.html",
      "permanent": false
    },
    {
      "source": "/maeen/",
      "destination": "https://maeen.saudigastro.com/website.html",
      "permanent": false
    },
    {
      "source": "/eoe/:path*",
      "destination": "/EoE/:path*",
      "permanent": true
    },
    {
      "source": "/maeen",
      "destination": "https://maeen.saudigastro.com/website.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ibd-connect.vercel.app"
        }
      ],
      "destination": "https://rafeeq.saudigastro.com/:path*",
      "permanent": true
    }
  ]
}
